def vlm_inference_loop():
    global TIME_OUT
    global image_idx 
    if latest_frame is None :
        node_logger.info(" no fame in the buffer")
        return
    try:
        use_franme = latest_frame
        payload = {
            "model": "/models/cosmos-reason2-8b",
            "messages": [
                {    
                    "role": "system",
                    "content": [{"type": "text", "text": "You are a helpful assistant."}]
                },

                {
                    "role": "user",
                    "content": [
                        #bird eye view
                        {
                            "type":     "image_url",
                            "image_url":  {"url": f"data:image/jpeg;base64,{base_brid_eye_img}"}
                        },

                        {
                            "type":     "image_url",
                            "image_url":  {"url": f"data:image/jpeg;base64,{use_franme}"}
                        },
                        {
                            "type":     "text",
                            "text":      finetuning_prompt
                        }
                    ]
                }
            ],
            "max_tokens": 4090 #4096 
        }
        response = requests.post(
            "http://localhost:8000/v1/chat/completions",
            json=payload,
            timeout=None
        )

        if response.status_code == 200:
            message = response.json()['choices'][0]['message']
            node_logger.info(f" adsad: {message}")
            result_text = message.get('content') or message.get('reasoning_content') or ""
            node_logger.info(f"Cosmos Output: {result_text}")
            parse_and_publish_velocity(result_text)
            image_idx +=1
        else:
            node_logger.error(f"vLLM Error {response.status_code}: {response.text}")

    except Exception as e:
        node_logger.error(f"VLM loop failed: {str(e)}")



